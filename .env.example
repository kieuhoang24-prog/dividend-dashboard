# ─── Dividend Dashboard ──────────────────────────────────────────────
# Where the dashboard container finds Ghostfolio on the compose network.
# When running the server outside Docker, use http://localhost:3333
GHOSTFOLIO_URL=http://ghostfolio:3333

# Ghostfolio security token: open Ghostfolio → My Ghostfolio → Account
# → Security → "Security token" → copy. Leave empty to run in demo mode.
GHOSTFOLIO_TOKEN=

BASE_CURRENCY=GBP
REFRESH_SECONDS=300
PORT=8090

# ─── Ghostfolio stack secrets (change these on first install!) ───────
ACCESS_TOKEN_SALT=please-change-this-random-salt
JWT_SECRET_KEY=please-change-this-too-with-a-long-random-string

POSTGRES_USER=gf
POSTGRES_PASSWORD=change-me-pg-password
POSTGRES_DB=ghostfolio
DATABASE_URL=postgresql://gf:change-me-pg-password@postgres:5432/ghostfolio?schema=public

REDIS_PASSWORD=change-r…edis
